# Public browser mode
NEXT_PUBLIC_GUEST_MODE=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-side AI only — never prefix secrets with NEXT_PUBLIC_
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# Optional historical data provider (Massive preferred, Twelve Data fallback)
MASSIVE_API_KEY=
TWELVE_DATA_API_KEY=
HISTORICAL_DATA_PUBLIC=false

# Optional account/cloud persistence
DATABASE_URL=
AUTH_SECRET=
